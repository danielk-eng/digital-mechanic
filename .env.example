# Copy to .env (cp .env.example .env) and set the LLM key. Do not commit .env.
# --- task materials (organizers 27.11): stubs, vehicle cards and engine manuals are NOT in git; the link to the
# organizers' materials folder (Yandex Disk public link or a direct .zip URL) is set here, not in code ---
TASK_MATERIALS_URL=
# Full manual PDF on the stand (organizers' answer pending): 0 = only the cited page (default), 1 = whole PDF
MANUAL_FULL_PDF=0
# --- external services (TZ F6): replace mock URLs with production ones here ---
# ML_SERVICE_URL=http://127.0.0.1:8001
# TOIR_SERVICE_URL=http://127.0.0.1:8002
# --- LLM: any OpenAI-compatible endpoint ---
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017-free
# off = без "размышлений" модели (в ~4 раза быстрее), on = по умолчанию модели
LLM_THINKING=off
LLM_API_KEY=
# set a spend limit on this key in the provider's console (see docs/ПУБЛИКАЦИЯ.md, «Ключи»)
# --- voice / translation (optional) ---
DEEPGRAM_API_KEY=
SILERO_ENABLED=0
# Cloud.ru GigaChat/SaluteSpeech is the primary Russian server voice when CLOUDRU_API_KEY is set.
# Multilingual SaluteSpeech access is explicit: enable after the Cloud.ru request is active and validated.
CLOUDRU_TTS=1
CLOUDRU_TTS_VOICE=Bab-Freespeech
CLOUDRU_TTS_LANGS=ru,kk,uz,ky
CLOUDRU_ASR_LANGS=ru,kk,uz,ky
# If multilingual access is unavailable for the account, narrow both values to ru.
# NVIDIA Build: batch translation (nvidia/nemotron-3.5-bolt-e4b), server TTS
# (Chatterbox ru over gRPC, Magpie hi/vi over HTTP) and Russian Parakeet speech recognition.
# Put the key only here or in the Vercel env, never in git.
NVIDIA_API_KEY=
NVIDIA_TRANSLATE_ENABLED=1
NVIDIA_TRANSLATE_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_TTS_ENABLED=1
NVIDIA_STT_ENABLED=1
# --- tracing (optional) ---
COMET_API_KEY=
# --- 152-FZ ---
AUDIT_RETENTION_DAYS=90
PII_MASKING=1
REQUIRE_CONSENT=1
