# Copy to .env (cp .env.example .env) and set the LLM key. Do not commit .env.
# --- external services (TZ F6): replace mock URLs with production ones here ---
# ML_SERVICE_URL=http://127.0.0.1:8001
# TOIR_SERVICE_URL=http://127.0.0.1:8002
# --- LLM: any OpenAI-compatible endpoint ---
LLM_BASE_URL=https://api.tokenrouter.com/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017-free
# off = без "размышлений" модели (в ~4 раза быстрее), on = по умолчанию модели
LLM_THINKING=off
LLM_API_KEY=
# --- voice (optional) ---
DEEPGRAM_API_KEY=
SILERO_ENABLED=0
# --- tracing (optional) ---
COMET_API_KEY=
# --- 152-FZ ---
AUDIT_RETENTION_DAYS=90
PII_MASKING=1
REQUIRE_CONSENT=1
