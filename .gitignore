# --- env / secrets (never publish) ---
.env
.env.*
!.env.example
*.key
*_key
.tokenrouter_key
secrets/
# --- python / tooling ---
.venv/
__pycache__/
*.pyc
.cache/
.pytest_cache/
runs/
# --- runtime data (users, audit, uploads: 152-FZ) ---
var/
*.db
*.db-wal
*.db-shm
*.log.jsonl
# --- customer / third-party materials not for the public repo ---
materials/
data/manuals/*.pdf
data/extra/images/
*.m4a
*.mp3
*.wav
*.webm
*.mp4
*.sqlite
*.part
*.zip
# KAMAZ manual from an unofficial mirror: excluded by owner decision 26.11
*kamaz*
*KAMAZ*
# OEM manual texts (engine manuals of the task, Ural / MAZ / UAZ manuals from the makers' sites): no redistribution
# right, so not in the public repo. They live on the stand only; deploy bundles take them from disk
# (scripts/stand_bundle.sh, scripts/vercel_bundle.sh). A fresh clone rebuilds the engine index from the PDFs: docs/ПУБЛИКАЦИЯ.md
data/index/*.jsonl.gz
data/i18n/pages_*.jsonl.gz
