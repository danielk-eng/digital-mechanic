{
  "appId": "ru.iikuznitsa.mechanic",
  "appName": "Цифровой механик",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0e1013",
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0e1013",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER",
      "showSpinner": false
    }
  }
}
