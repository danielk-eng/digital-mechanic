# Local GPU mode (docs/LOCAL_GPU.md). Copy to .env, then:
#   docker compose -f docker-compose.yml -f docker-compose.local-gpu.yml --profile gpu3090 up -d   (or --profile spark)
# No secrets here: LOCAL_LLM_KEY only guards the LLM port inside the host network.
LOCAL_LLM_KEY=change-me-local
MODELS_DIR=./var/models

# --- mode ---
# tokenrouter = the OpenAI-compatible slot, here pointing at the local LLM (local first).
# Strict local (152-FZ, nothing leaves the site): leave CLOUDRU_API_KEY and DEEPGRAM_API_KEY empty.
# Hybrid: set CLOUDRU_API_KEY -> GigaChat-4 on Cloud.ru (servers in RF) is used only when the local LLM fails; PII is masked.
LLM_PRIMARY=tokenrouter
CLOUDRU_API_KEY=
DEEPGRAM_API_KEY=
LLM_TURN_BUDGET_S=90

# --- RTX 3090 (profile gpu3090) ---
LOCAL_GGUF=unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M
LOCAL_CTX_TOTAL=36864
LOCAL_SLOTS=3
# alternative, more VRAM headroom: LOCAL_GGUF=ggml-org/gpt-oss-20b-GGUF  (then WHISPER_DEVICE=cuda)
WHISPER_DEVICE=cpu
GIGAAM_DEVICE=cuda

# --- DGX Spark (profile spark) ---
# SPARK_VLLM_IMAGE=nvcr.io/nvidia/vllm:26.11-py3
# SPARK_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8          # or NVFP4/Qwen3-30B-A3B-Instruct-2507-FP4 (needs native FP4 kernels)
# SPARK_MODEL=openai/gpt-oss-120b  SPARK_TOOL_PARSER=openai  SPARK_GPU_UTIL=0.6
# SPARK_GPU_UTIL=0.45
# LOCAL_MAX_LEN=16384
# SPEECH_BASE_IMAGE=nvcr.io/nvidia/pytorch:26.11-py3
