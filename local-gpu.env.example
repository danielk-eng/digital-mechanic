# Local GPU mode (docs/LOCAL_GPU.md). Copy to .env, then one of:
#   docker compose -f docker-compose.yml -f docker-compose.local-gpu.yml --profile gpu3090 up -d        # 3090: Qwen3.8-27B (quality, vision)
#   docker compose -f docker-compose.yml -f docker-compose.local-gpu.yml --profile gpu3090-fast up -d   # 3090: Qwen3-30B-A3B (fast)
#   docker compose -f docker-compose.yml -f docker-compose.local-gpu.yml --profile spark up -d          # Spark: 30B-A3B + 27B (llm-quality)
# Switching 3090 profiles: `docker compose ... --profile gpu3090 down` first (both LLMs do not fit on 24 GB together).
# No secrets here: LOCAL_LLM_KEY only guards the LLM port inside the host network.
LOCAL_LLM_KEY=change-me-local
MODELS_DIR=./var/models

# --- mode ---
# tokenrouter = the app's OpenAI-compatible slot, here pointing at the local LLM (local first).
# Strict local (152-FZ, nothing leaves the site): leave CLOUDRU_API_KEY and DEEPGRAM_API_KEY empty.
# Hybrid: set CLOUDRU_API_KEY -> GigaChat-4 on Cloud.ru (servers in RF) only when the local LLM fails; PII is masked.
LLM_PRIMARY=tokenrouter
CLOUDRU_API_KEY=
DEEPGRAM_API_KEY=
LLM_TURN_BUDGET_S=90
# which local server the app talks to: http://llm:8080/v1 (default) or, on Spark, http://llm-quality:8080/v1 (Qwen3.8-27B)
LOCAL_LLM_URL=http://llm:8080/v1

# --- RTX 3090, profile gpu3090: Qwen3.8-27B ---
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda-b12808
LOCAL_GGUF=unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_M
LOCAL_CTX_TOTAL=24576
LOCAL_SLOTS=2
LOCAL_MTP_N=2
# LOCAL_EXTRA_ARGS=--no-mmproj        # drop vision (saves ~0.9 GiB)
# --- RTX 3090, profile gpu3090-fast: Qwen3-30B-A3B ---
LOCAL_GGUF_FAST=unsloth/Qwen3-30B-A3B-Instruct-2507-GGUF:Q4_K_M
LOCAL_CTX_TOTAL_FAST=36864
LOCAL_SLOTS_FAST=3
# speech on the 3090
WHISPER_DEVICE=cpu
GIGAAM_DEVICE=cuda

# --- DGX Spark, profile spark ---
# SPARK_VLLM_IMAGE=vllm/vllm-openai:v0.32.0          # alt: nvcr.io/nvidia/vllm:26.11-py3
# SPARK_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507-FP8    # candidate: Qwen/Qwen3.6-35B-A3B-FP8 (SPARK_TOOL_PARSER=qwen3_coder)
# SPARK_GPU_UTIL=0.35
# SPARK_QUALITY_MODEL=nvidia/Qwen3.8-27B-NVFP4-QAD    # or Qwen/Qwen3.8-27B-FP8 with SPARK_QUALITY_QUANT_ARGS= (empty)
# SPARK_QUALITY_GPU_UTIL=0.30
# LOCAL_MAX_LEN=16384
# SPEECH_BASE_IMAGE=nvcr.io/nvidia/pytorch:26.11-py3
